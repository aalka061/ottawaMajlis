# Supabase — Project settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The secret key (sb_secret_...). SUPABASE_SECRET_KEY works too.
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard at /admin
ADMIN_PASSWORD=
# Any long random string. Generate one with: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# Email — resend.com → API Keys. Sends the payment confirmation from /admin.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Replies go to CONTACT_EMAIL
# in src/lib/site.ts, not here.
EMAIL_FROM="Ottawa Majless <majless@techualize.com>"
